<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PandaCubeTimer.ViewModels"
             xmlns:models="clr-namespace:PandaCubeTimer.Models"
             xmlns:dtos="clr-namespace:PandaCubeTimer.Models.DTOs"
             xmlns:converters="clr-namespace:PandaCubeTimer.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewModels:SessionsViewModel"
             Title="Sessions"
             x:Class="PandaCubeTimer.Views.SessionsView">
    
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Loaded" Command="{Binding LoadSessionsCommand}"/>
    </ContentPage.Behaviors>
    
    <ContentPage.Content>
        <Grid>
            
            <RefreshView Command="{Binding LoadSessionsCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         Padding="5">
                
                <CollectionView Background="Transparent"
                                SelectionMode="Single" 
                                x:Name="SessionsList"
                                ItemsSource="{Binding Sessions}">
                    
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:SessionDTO">
                            <Frame Padding="10,15"> 
                                
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding}"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SessionsViewModel}}, Path=SelectSessionCommand }"/>
                                </Frame.GestureRecognizers>
                                
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#2196F3" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Frame" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#2A2A2A}" />
                                    </DataTrigger>
                                </Frame.Triggers>
                                
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    
                                    <HorizontalStackLayout Grid.Column="0"
                                                           Spacing="10"
                                                           VerticalOptions="Center"
                                                           Background="Transparent">
                                        
                                        <Label x:Name="DisciplineNameLabel"
                                               Text="{Binding DisciplineName}"
                                               VerticalOptions="Center"
                                               FontAutoScalingEnabled="True"
                                               FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#E0E0E0" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="Gray" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Line VerticalOptions="Center" BackgroundColor="Blue" Y2="20" />

                                        <Label x:Name="SessionNameLabel"
                                               Text="{Binding Name}"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <!-- RIGHT: Sync Individual Session Button -->
                                    <Button Grid.Column="1"
                                            Text="↻"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            CornerRadius="20"
                                            Padding="0"
                                            FontSize="18"
                                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SessionsViewModel}}, Path=IsSyncVisible}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SessionsViewModel}}, Path=SyncSingleSessionCommand}"
                                            CommandParameter="{Binding}" />

                                    <!-- RIGHT: Delete Session Button -->
                                    <Button Grid.Column="2"
                                            Text="🗑"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            CornerRadius="20"
                                            Padding="0"
                                            FontSize="18"
                                            BackgroundColor="#F44336"
                                            TextColor="White"
                                            IsVisible="{Binding CanDelete}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SessionsViewModel}}, Path=DeleteSessionCommand}"
                                            CommandParameter="{Binding}" />

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                </CollectionView>
                
            </RefreshView>
            
            <!-- FLOATING ACTION BUTTONS  -->
            <VerticalStackLayout HorizontalOptions="End"
                                 VerticalOptions="End"
                                 Margin="0, 0, 20, 20"
                                 Spacing="15">
                
                <Button Text="↻"
                        Command="{Binding StartSyncFlowCommand}"
                        WidthRequest="50" HeightRequest="50" CornerRadius="25" 
                        BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"
                        TextColor="White" FontSize="24" FontAttributes="Bold" 
                        IsVisible="{Binding IsSyncVisible}"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2}"/>

                <Button Text="+"
                        Command="{Binding AddSessionCommand}"
                        WidthRequest="60" HeightRequest="60" CornerRadius="30" 
                        BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#64B5F6}"
                        TextColor="White" FontSize="28" FontAttributes="Bold" 
                        Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2}"/>
                        
            </VerticalStackLayout>
            
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center"/> 
            
        </Grid>
    </ContentPage.Content>
</ContentPage>