<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PandaCubeTimer.Views.Controls.StatBox"
             x:Name="This">
    <Frame Style="{StaticResource CardStyle}" >
        <VerticalStackLayout Spacing="2">
            <Label Text="{Binding Title, Source={x:Reference This}}" FontSize="10" Opacity="0.6" HorizontalOptions="Center"/>
            <Label Text="{Binding Value, Source={x:Reference This}}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Frame>
</ContentView>