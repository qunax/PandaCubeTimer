<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controlViewModels="clr-namespace:PandaCubeTimer.ViewModels.ControlsVMs"
             x:Class="PandaCubeTimer.Views.Controls.ActiveSessionBar"
             x:DataType="controlViewModels:ActiveSessionBarViewModel">
    
    <Frame Padding="15,10" 
           CornerRadius="0" 
           BorderColor="Transparent"
           HasShadow="False">
           
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
            <Label Text="Active:" 
                   FontSize="16"
                   TextColor="Gray" 
                   VerticalOptions="Center"/>
            
            <Label Text="{Binding ActiveSessionStore.CurrentSessionDTO.Name, FallbackValue='None Selected'}" 
                   FontAttributes="Bold" 
                   FontSize="16"
                   TextColor="{AppThemeBinding
                      Light={StaticResource  BlackEars}, 
                      Dark={StaticResource WhiteWool}}"
                   VerticalOptions="Center"/>
                   
            <Label Text="{Binding ActiveSessionStore.CurrentSessionDTO.DisciplineName, FallbackValue=''}" 
                   TextColor="{StaticResource BambooGreen}" 
                   FontAttributes="Bold"
                   FontSize="16"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>
    </Frame>
       
</ContentView>