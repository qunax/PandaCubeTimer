<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PandaCubeTimer.Models"
             xmlns:viewModels="clr-namespace:PandaCubeTimer.ViewModels"
             xmlns:controls="clr-namespace:PandaCubeTimer.Views.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:PandaCubeTimer.Converters"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:controls1="clr-namespace:PandaCubeTimer.Views.Controls"
             x:DataType="viewModels:TimerViewModel"
             x:Class="PandaCubeTimer.Views.TimerView"
             Title="Timer">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InspectionPenaltyToAfterSolvePenaltyVisibilityConverter x:Key="InspectionPenaltyToAfterSolvePenaltyVisibilityConverter"/>
        </ResourceDictionary>
        
        <ResourceDictionary>
            <Style x:Key="PenaltyButtonStyle" TargetType="Border">
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="WidthRequest" Value="75" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BlackEarsCard}}" />
            </Style>

            <Style x:Key="PenaltyLabelStyle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Timer">
            
            <MenuFlyoutItem Text="Start Timer" Command="{Binding StartTimerCommand}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key=" " Modifiers="None"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            
            <MenuFlyoutItem Text="Generate New Scramble" Command="{Binding GenerateScrambleCommand}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="G" Modifiers="Shift"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            
        </MenuBarItem>
    </ContentPage.MenuBarItems>
    
    <Grid RowDefinitions="Auto, *">
        
        <controls:ActiveSessionBar x:Name="ActiveSessionBar" Grid.Row="0" />
        
        <Grid Padding="5,15,5,5"
              Grid.Row="1">
        
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <VerticalStackLayout Grid.Row="0"
                                 x:Name="Scramble"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Margin="0, 20, 0, 0">
                
                <Label x:Name="ScrambleText"
                       Text="{Binding Scramble}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FontSize="25">
                    <Label.Behaviors>
                        <toolkit:EventToCommandBehavior
                            EventName="Loaded"
                            Command="{Binding GenerateScrambleCommand}"/>
                    </Label.Behaviors>    
                </Label>
                
                <Button x:Name="RefreshScrambleButton"
                        Text="{mi:Material Refresh, IconSize=Large}" 
                        Command="{Binding GenerateScrambleCommand}"
                        MaximumWidthRequest="60"
                        MaximumHeightRequest="60"
                        Margin="10"
                        Padding="0"/>
                
            </VerticalStackLayout>
                
            <Frame  x:Name="SolveTime"
                    Grid.Row="1"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    Padding="0"
                    BackgroundColor="Transparent"
                    HasShadow="False"
                    BorderColor="Transparent" >

                <!-- here idk why but tab gesture on android is working  -->
                <!-- and I prefer to use it so i don't have to change Z index of penalty buttons -->
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartTimerCommand}"/>
                </Frame.GestureRecognizers>

                <Grid VerticalOptions="Center"
                      HorizontalOptions="Center" >
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Label Grid.Row="0" 
                           Text="{Binding TimeTextToDisplay}"
                           FontSize="40"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalTextAlignment="Center"
                           VerticalOptions="Center"
                           x:Name="LastTimeSolved" />
                    
                    <HorizontalStackLayout Grid.Row="1" 
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       Spacing="12" 
                       IsVisible="{Binding ArePenaltiesVisible}"
                       Margin="0, 15, 0, 0">

                        <Border Style="{StaticResource PenaltyButtonStyle}"
                                Stroke="{StaticResource ChineseSeal}"
                                IsVisible="{Binding CurrentlyMadeSolve, Converter={StaticResource InspectionPenaltyToAfterSolvePenaltyVisibilityConverter}, ConverterParameter={x:Static local:SolvePenalty.DNF}}">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource ChineseSeal}" Offset="0,0" Radius="8" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PenalizeLastSolveCommand}" CommandParameter="{x:Static local:SolvePenalty.DNF}" />
                            </Border.GestureRecognizers>
                            <Label Style="{StaticResource PenaltyLabelStyle}" Text="DNF" TextColor="{StaticResource ChineseSeal}" />
                        </Border>

                        <Border Style="{StaticResource PenaltyButtonStyle}"
                                Stroke="#FF8C00"
                                IsVisible="{Binding CurrentlyMadeSolve, Converter={StaticResource InspectionPenaltyToAfterSolvePenaltyVisibilityConverter}, ConverterParameter={x:Static local:SolvePenalty.PlusTwo}}">
                            <Border.Shadow>
                                <Shadow Brush="#FF8C00" Offset="0,0" Radius="8" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PenalizeLastSolveCommand}" CommandParameter="{x:Static local:SolvePenalty.PlusTwo}" />
                            </Border.GestureRecognizers>
                            <Label Style="{StaticResource PenaltyLabelStyle}" Text="+2" TextColor="#FF8C00" />
                        </Border>

                        <Border Style="{StaticResource PenaltyButtonStyle}"
                                Stroke="{StaticResource Gray500}"
                                IsVisible="{Binding CurrentlyMadeSolve, Converter={StaticResource InspectionPenaltyToAfterSolvePenaltyVisibilityConverter}, ConverterParameter={x:Static local:SolvePenalty.Delete}}">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Gray500}" Offset="0,0" Radius="8" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PenalizeLastSolveCommand}" CommandParameter="{x:Static local:SolvePenalty.Delete}" />
                            </Border.GestureRecognizers>
                            <Label Style="{StaticResource PenaltyLabelStyle}" Text="Delete" TextColor="{StaticResource Gray500}" />
                        </Border>

                        <Border Style="{StaticResource PenaltyButtonStyle}"
                                Stroke="{StaticResource BambooGreen}"
                                IsVisible="{Binding CurrentlyMadeSolve, Converter={StaticResource InspectionPenaltyToAfterSolvePenaltyVisibilityConverter}, ConverterParameter={x:Static local:SolvePenalty.NoPenalty}}">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource BambooGreen}" Offset="0,0" Radius="10" Opacity="0.4" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PenalizeLastSolveCommand}" CommandParameter="{x:Static local:SolvePenalty.NoPenalty}" />
                            </Border.GestureRecognizers>
                            <Label Style="{StaticResource PenaltyLabelStyle}" Text="OK" TextColor="{StaticResource BambooGreen}" />
                        </Border>

                    </HorizontalStackLayout>
                    
                </Grid>
                
            </Frame>
            
            <Grid Grid.Row="2">
                
            </Grid>
        </Grid>
        
    </Grid>
</ContentPage>