<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PandaCubeTimer.ViewModels"
             xmlns:converters="clr-namespace:PandaCubeTimer.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:PandaCubeTimer.Views.Controls"
             x:Class="PandaCubeTimer.Views.InspectionView"  
             x:DataType="viewModels:InspectionViewModel"
             Shell.TabBarIsVisible="False">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:RemainedTicksToInspectionTextConverter x:Key="RemainedTicksToInspectionTextConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Timer">
            <MenuFlyoutItem Text="Start Timer" Command="{Binding  StartTimerCommand}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key=" " />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

        </MenuBarItem>
    </ContentPage.MenuBarItems>
    
    <Grid>
        
        <Border StrokeThickness="0"
                BackgroundColor="Transparent" 
                VerticalOptions="Fill"
                HorizontalOptions="Fill">
            
            <Label Text="{Binding RemainedTicks, Converter={StaticResource RemainedTicksToInspectionTextConverter}}"
                   FontSize="60" 
                   FontAttributes="Bold"
                   TextColor="{Binding TimerColor}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   x:Name="TimeText" />
        </Border>
        
        <!-- using this instead of TapGestureRecognizer because of the bug on Android -->
        <controls:TouchOverlayButton PressedCommand="{Binding ChangeColorOnPressCommand}"
                                     ReleasedCommand="{Binding StartTimerCommand}"/>
        
    </Grid>
</ContentPage>