<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:viewModels="clr-namespace:PandaCubeTimer.ViewModels"
             xmlns:controls="clr-namespace:PandaCubeTimer.Views.Controls"
             xmlns:models="clr-namespace:PandaCubeTimer.Models"
             xmlns:converters="clr-namespace:PandaCubeTimer.Converters"
             x:Class="PandaCubeTimer.Views.StatsView"
             x:DataType="viewModels:StatsViewModel">
    
    <ContentPage.Behaviors>
            <toolkit:EventToCommandBehavior 
                EventName="Appearing" 
                Command="{Binding RefreshCommand}" />
    </ContentPage.Behaviors>
        
    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *">
        
            <controls:ActiveSessionBar x:Name="ActiveSessionBar" Grid.Row="0" />
            
            <RefreshView Grid.Row="1"
                         Command="{Binding RefreshCommand}"
                         IsRefreshing="{Binding IsRefreshing}">
                <ScrollView Padding="10">
                    <VerticalStackLayout Spacing="15">
                    
                        <!-- Top Level Summary -->
                        <Frame Style="{StaticResource CardStyle}">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="30">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding SolveCount}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="Solves" FontSize="12" Opacity="0.7" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding BestSingle}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="Best" FontSize="12" Opacity="0.7" HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding SessionMean}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="Mean" FontSize="12" Opacity="0.7" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- Current Averages Section -->
                        <Label Text="Current Averages" FontAttributes="Bold" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                            <controls:StatBox Title="Ao5" Value="{Binding CurrentAo5}" Grid.Column="0"/>
                            <controls:StatBox Title="Ao12" Value="{Binding CurrentAo12}" Grid.Column="1"/>
                            <controls:StatBox Title="Ao100" Value="{Binding CurrentAo100}" Grid.Column="2"/>
                        </Grid>

                        <!-- Best Averages Section -->
                        <Label Text="Personal Bests" FontAttributes="Bold" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                            <controls:StatBox Title="Best Ao5" Value="{Binding BestAo5}" Grid.Column="0" />
                            <controls:StatBox Title="Best Ao12" Value="{Binding BestAo12}" Grid.Column="1" />
                            <controls:StatBox Title="Best Ao100" Value="{Binding BestAo100}" Grid.Column="2" />
                        </Grid>

                        <!-- Graphs Placeholder -->
                        <Label Text="Time Trend" FontAttributes="Bold" Margin="0,15,0,5"/>
                        <Frame HeightRequest="250" Style="{StaticResource CardStyle}" Padding="15">
                            <lvc:CartesianChart
                                Series="{Binding TimeTrendSeries}"
                                XAxes="{Binding TimeTrendXAxes}"
                                YAxes="{Binding TimeTrendYAxes}"
                                TooltipPosition="Hidden"
                                BackgroundColor="{AppThemeBinding
                                     Light={StaticResource White}, 
                                     Dark= {StaticResource BlackEarsCard}}"/> <!-- Set to 'Top' if you want popups on tap -->
                        </Frame>
                        
                        <Label Text="Time Distribution" FontAttributes="Bold" Margin="0,15,0,5"/>
                        <Frame HeightRequest="250" Style="{StaticResource CardStyle}" Padding="15">
                            <lvc:CartesianChart
                                Series="{Binding TimeDistributionSeries}"
                                XAxes="{Binding TimeDistributionXAxes}"
                                YAxes="{Binding TimeDistributionYAxes}"
                                TooltipPosition="Hidden" 
                                BackgroundColor="{AppThemeBinding
                                     Light={StaticResource White}, 
                                     Dark= {StaticResource BlackEarsCard}}"/>
                        </Frame>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>
    </ContentPage.Content>
</ContentPage>