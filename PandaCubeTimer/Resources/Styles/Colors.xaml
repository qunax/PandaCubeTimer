<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BambooGreen">#4DA167</Color>
    <Color x:Key="WhiteWool">#F5F7F6</Color>
    <Color x:Key="BlackEars">#1A2421</Color>
    <Color x:Key="BlackEarsCard">#24302C</Color>
    <Color x:Key="ChineseSeal">#E55B5B</Color>
    <Color x:Key="LightOolong">#E8EFEA</Color>

    <Color x:Key="Primary">#4DA167</Color>
    <Color x:Key="Secondary">#E8EFEA</Color>
    <Color x:Key="Tertiary">#1A2421</Color>
    <Color x:Key="White">#F5F7F6</Color> 
    <Color x:Key="Black">#1A2421</Color> 
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource BambooGreen}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource LightOolong}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource BlackEars}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ChineseSeal}"/>
</ResourceDictionary>